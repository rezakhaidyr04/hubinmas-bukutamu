<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to application and configuration files.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|vite\.config\.js|phpunit\.xml)$ - [F,L,NC]

    # Serve existing public assets (build files, images, favicon, etc.).
    # This lets the whole project be uploaded to public_html safely.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send application routes to Laravel's front controller.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^ public/index.php [L]
</IfModule>
